    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/webp": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "exifr": "^7.1.3",
    "file-saver": "^2.0.5",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.76.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
