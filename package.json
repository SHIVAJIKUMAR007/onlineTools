{
  "name": "stayput-tools",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Free online tools that run entirely in your browser. Files never leave your device.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx scripts/prerender.ts",
